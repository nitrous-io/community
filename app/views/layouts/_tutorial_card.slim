.tutorial.card
  .content
    .visual class=("overlay-#{rand(1..5)}")
      a href=(tutorial_path(slug: tutorial.slug))
        = image_tag 'tutorial-visual-nitrous.png', class:"for-visual"

    h3.card-title
      = link_to tutorial.title, tutorial_path(slug: tutorial.slug)

    .status
      a.hearts href="#"
        span 2
      a.comments href="#"
        span 6

    .card-footer
      .author
        .gravatar
          img src="http://www.gravatar.com/avatar/00000000000000000000000000000000?d=retro&amp;f=y"
        = tutorial.author.capitalize
      - if tutorial.tags.present?
        - tutorial.tags.each do |tag|
          .tags
            = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}
