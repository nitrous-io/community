ruby:
  kind ||= :tutorial
  search_path = case kind
    when :post
      posts_search_index_path
    when :tutorial
      tutorials_search_index_path
    else
      docs_search_index_path
  end

= form_tag search_path, method: :get, class: 'search-field' do
  = text_field_tag 'q', @query, placeholder: 'Search'
