= form_for _item, url: _url, method: _method, html: { id: _form_id } do |f|
  .form-wrapper
    .row
      = f.text_field :title, tabindex: 1, placeholder: "Title", class: "for-title"

    - if defined?(_tags) && _tags
      .row
        = f.text_field :tag_list, 'data-role' => 'tagsinput', tabindex: 3, value: f.object.tag_list.join(', ')

    - if defined?(_post_cover_image) && _post_cover_image
      .row data-for="cover"
        = f.text_field :cover_image_url, placeholder: 'Cover image (URL)', tabindex: 2

    - if defined?(_doc_category) && _doc_category
      .row.custom-select
        = f.select :doc_category_id, @categories.map { |c| [c.name, c.id] }

    .row
      = f.hidden_field :published_at, class: 'published_at', value: f.object.published_at.try(:iso8601)
      input.published_at_picker type='text' placeholder='Publish Date'

    #markdown-preview
      .tabs.as-icons
        ul
          li.markdown.active
            a href='#' data-tab='#markdown' Mardown
          li.preview
            a href='#' data-tab='#preview' Preview

      .tabs-content
        #markdown.active
          = f.text_area :content_markdown, class: 'markdown-text-js', rows: 15, tabindex: 2, 'data-attachment-allowed' => true
        #preview
          .preview-content-js
