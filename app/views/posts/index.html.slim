- flash.each do |name, message|
  div class="new-blog-post #{name}"
    = message.humanize

.blog-index
  = link_to 'New Post', new_blog_path

  - @posts.each do |post|
    h1.title
      = link_to post.title, posts_slugged_path(slug: post.slug)
    .author-signature
      | By
    = post.user.username
      .time-signature
        | Published
        = time_ago_in_words(post.created_at)
        |  ago
    .tags
      - if post.tags.present?
        - post.tags.each do |tag|
          = link_to tag.name, posts_tagged_path(tag: tag.name)
    br
