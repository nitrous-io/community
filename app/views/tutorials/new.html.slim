.tutorial-new
  .errors
    = @tutorial.errors.full_messages.first if @tutorial.errors.any?

  .row 
    .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
      h1.title New Tutorial 
      .desc 
        | Submit your tutorials in markdown format. Fenced code blocks are supported.
        br
        | To include an image, upload the image below and copy ![name of image](image URL)

  = form_for @tutorial, url: tutorials_path do |f|
    .row 
      .dropzone-previews
    .row 
      .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
        .card-entry
          .row
            = f.label :title
          .row
            = f.text_field :title

          .row
            = f.label :content
          .row.content
            = f.text_area :content_markdown

          .row
            = f.label :tag_list
          .row
            = f.text_field :tag_list, placeholder: "eg. ruby, rails"

    .row
      .col-xs-4.col-md-4.col-lg-4.col-md-offset-5.col-lg-offset-5
        .card-submit-btn
          = f.submit "Submit new tutorial"

.row
  .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
    = form_tag '/image_contents', method: :post, class: "dropzone form", id: "image-dropzone" do
      .fallback
        = file_field_tag "images", multiple: true

.row style=("margin-top: 25px;") 
  .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
    .well
      .row
        #image-contents.col-lg-12
