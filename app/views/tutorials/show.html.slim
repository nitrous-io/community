.main
  .container
    
    / = link_to 'Edit', edit_tutorial_path(@tutorial.id), role: 'button', class: 'btn btn-default'
    article
      .title
        h2
          = @tutorial.title

      .meta
        .author
          span
            = @tutorial.user.username.capitalize
        span &bull;
        .timestamp
          span
            | 2 days ago

      .content
        = @tutorial.content_html.html_safe

      .footer
        .gravatar
          img src="http://www.gravatar.com/avatar/00000000000000000000000000000000?d=retro&amp;f=y"

        .author
          span
            = @tutorial.user.username

        .status
          / = button_to "hearts", tutorial_likes_path(@tutorial.id), method: :post
          a.hearts href="#"
            span
              = @tutorial.score
          a.comments href="#"
            span 6

          a.share href="#"
            span Share

      / .tags
      /   - if @tutorial.tags.present?
      /     - @tutorial.tags.each do |tag|
      /       = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

.main.darker
  .container

    article
      .title
        h2
          | Comments

      .form-wrapper
        = form_for @comment, url: tutorial_comments_path(@tutorial.id) do |f|
          = f.text_area :content

          .row
            = f.submit "Post comment"

      .comment-list
        - @comments.each do |comment|
          .comment
            .meta
              .author
                = comment.user.username.capitalize
              .timestamp
                = time_ago_in_words(comment.created_at)
                '  ago
            .content
              = comment.content
