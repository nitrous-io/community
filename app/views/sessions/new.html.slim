.row.center-xs.title
  .col-xs
    h2.section-title
      | Log In
    p.desc
      - flash.each do |name, message|
        = message.humanize


.row.center-xs
  .col-xs-4
    .form-wrapper
      = form_for :user, url: login_path do |f|
        .row
          = f.text_field :username_or_email, { :placeholder => "Username, or Email"}

        .row
          = f.password_field :password, { :placeholder => "Password"}

        .row
          = f.submit "Log In"
