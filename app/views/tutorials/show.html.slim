- @title = @tutorial.title
- content_for :header_accessory
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Tutorial', edit_tutorial_path(@tutorial.id)
          - if @tutorial.published?
            li
              = link_to 'Unpublish', unpublish_tutorial_path(@tutorial.id), data: { method: :put }
          - else
            li
              = link_to 'Publish', publish_tutorial_path(@tutorial.id), method: :put
      .divider
  
.main
  .container
    article
      .title
        h2
          = @tutorial.title

      .meta
        .timestamp
          span
            = l @tutorial.created_at, format: :simple
        .tags
          - if @tutorial.tags.present?
            - @tutorial.tags.each do |tag|
              = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

      .content
        = @tutorial.content_html.html_safe

      .footer
        .heart
          = button_to "Heart", tutorial_likes_path(tutorial_id: @tutorial.id), method: :post, class: "status-icon heart"

        .status            
          a.status-icon.comment href="#comments"
            span Comment

          a.status-icon.share href="#share"
            span Share
          
          = render partial: 'partials/sharer'

      / .tags
      /   - if @tutorial.tags.present?
      /     - @tutorial.tags.each do |tag|
      /       = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

.main.darker
  .container

    article#comments
      .title
        h2
          | Comments

      .form-wrapper
        = form_for @comment, url: tutorial_comments_path(@tutorial.id) do |f|
          = f.text_area :content, placeholder: "Write a comment..."

          .row
            = f.submit "Post comment"

      .comment-list
        - @comments.each do |comment|
          = render partial: 'partials/comment', locals: { comment: comment }

