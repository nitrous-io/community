ruby:
  _home_path = case controller.controller_name
    when 'tutorials' then tutorials_path
    when 'posts' then posts_path
    when 'docs' then docs_path
    else
      root_path
  end

header.fixed
  .container
    h1.logo
      a href=(_home_path)
        span
          em Nitrous
          '
          - if @small_nav_title.present?
            small
              = @small_nav_title
          - elsif controller.controller_name == 'tutorials'
            small Tutorials
          - elsif controller.controller_name == 'posts'
            small Blog
          - elsif controller.controller_name == 'doc_categories'
            small Categories
          - elsif controller.controller_name == 'docs'
            small Docs
          - else
              small Community
        i.fa.fa-caret-down

      .dropdown-menu
        ul
          li class=(%w(home sessions).include?(controller.controller_name) ? 'active' : nil)
            a href=(root_path)
              small Community
          li class=(controller.controller_name == 'tutorials' ? 'active' : nil)
            a href=(tutorials_path)
              small Tutorials
          li class=(controller.controller_name == 'posts' ? 'active' : nil)
            a href=(posts_path)
              small Blog
          li class=(controller.controller_name == 'docs' ? 'active' : nil)
            a href=(docs_path)
              small Docs


    .actions
      .desktop
        = yield :search_field

        - if current_user.nil?
          - if controller.controller_name != 'sessions'
            = link_to "Log In / Sign Up", login_path(redirect_to: request.env['PATH_INFO'])

        - else
          = yield :header_accessory

          .dropdown
            .dropdown-toggle
              span.gravatar
                img src=(current_user.gravatar(40))
              span.username
                = current_user.username
              i.fa.fa-caret-down

              .dropdown-menu
                ul role="menu"
                  - if current_user.admin?
                    li
                      = link_to "New Tutorial", new_tutorial_path
                    li
                      = link_to "New Blog Post", new_post_path
                    li.separator
                    li
                      = link_to 'New Doc', new_doc_path
                    li
                      = link_to 'Categories', doc_categories_path
                    li.separator
                    li
                      = link_to 'Drafts', drafts_path
                    li.separator
                  li
                    = link_to "Log Out", sessions_path, method: :delete

      .menu-btn.mobile
        a.trigger href="#"


#mobile-menu
  ul.nav
    li
      = link_to "Community", root_path
    li
      = link_to "Tutorials", tutorials_path
    li
      = link_to "Blog", posts_path
    li
      = link_to "Docs", docs_path

    - if current_user.nil?
      li.separator
      li
        = link_to "Log In", login_path(redirect_to: request.env['PATH_INFO'])
      li
        a href="https://pro.nitrous.io/app/#/signup" Sign Up
    - else
      li.separator
      li
        = link_to "Log Out", sessions_path, method: :delete

    li.separator
    li
      a href="https://twitter.com/nitrous" target="_blank" Follow @Nitrous
    li
      p &copy; 2012-2015 Nitrous, Inc.
