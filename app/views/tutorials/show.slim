- @title = @content.title
- content_for :header_accessory do
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Tutorial', edit_tutorial_path(@content.id)
          - if @content.published?
            li
              = link_to 'Unpublish', unpublish_tutorial_path(@content.id), method: :post
          - else
            li
              = link_to 'Publish', publish_tutorial_path(@content.id), method: :post
          li.separator
          li
            = link_to 'Drafts', tutorials_drafts_path
      .divider

.main
  .container
    article
      .title
        h2
          = @content.title

      .meta
        .timestamp
          span
            = l @content.created_at, format: :simple
        .tags
          - if @content.tags.present?
            - @content.tags.each do |tag|
              = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

      .content
        = @content.content_html.html_safe

      .footer
        / .tags
        /   - if @tutorial.tags.present?
        /     - @tutorial.tags.each do |tag|
        /       = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

        = render partial: 'partials/heart', locals: { score: @content.score, is_upvoted: @is_upvoted, like_path: like_tutorial_path(@content.id), unlike_path: unlike_tutorial_path(@content.id) }

        a.status-icon.comment href="#the-comments"
          span
            = pluralize(@content.comments.count, 'Comment')

        a.status-icon.share href="#share"
          span Share

        = render partial: 'partials/sharer', locals: { url: tutorials_slugged_url(slug: @content.slug)}


.main.darker
  .container

    article#comments
      .title
        h2
          | Comments

      .form-wrapper
        - if current_user.present?
          = form_for @comment, url: tutorial_comments_path(@content.id) do |f|
            = f.text_area :content, placeholder: "Write a comment..."

            .row
              = f.submit "Post comment", class: 'btn blue'
        - else
          = link_to 'Log in to comment', login_path(redirect_to: request.env['PATH_INFO']), class: 'btn blue'

      #the-comments.comment-list
        - @comments.each do |comment|
          = render partial: 'partials/comment', locals: { comment: comment }

- content_for :body_script do
  = javascript_include_tag 'code-mirror'
  javascript:
    Community.ShowPage.init();
