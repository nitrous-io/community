- link = doc.published? ? docs_slugged_path(slug: doc.slug) : edit_doc_path(id: doc.id)

- tag_classes = doc.tags.map { |t| "tag-#{t}" }.join " "
.doc.card class=tag_classes
  .content
    .visual class=("overlay-#{rand(1..5)}")
      a href=(link)
        span.icon-overlay

    h3.card-title
      = link_to doc.title, link

    .status
      a.hearts href=(link)
        span
          = doc.score

    .card-footer
      .author
        .gravatar
          img src=(doc.user.gravatar(56))
        = doc.user.username
      - if doc.tags.present?
        - doc.tags.each do |tag|
          .tags
            = link_to tag.name, docs_tagged_path(tag: tag.name), { :class => "tag"}
