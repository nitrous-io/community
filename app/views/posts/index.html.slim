- if @posts.length > 0
  = render partial: 'partials/post_card', locals: { post: @posts[0], url_prefix: '/posts', focus: true}

  .main
    .container data-infinite-scroll="true" data-infinite-scroll-container="#posts"
      / = render partial: 'partials/flash_message'

      #posts
        = render partial: 'posts/list', locals: { posts: @posts.drop(1), next_page_path: @next_page_path }