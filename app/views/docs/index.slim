- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :doc }

.main.title-hero.docs
  .container
    .title
      h2 Documentation
    p.desc
      | Documentation &amp; help for everything Nitrous

.main
  .container
    #docs
      - if @content.present?
        = render partial: 'docs/list', locals: { docs: @content, toc: @toc }
      - else
        = render partial: 'docs/toc', locals: { toc: @toc }
