.main
  .container

    .title.centered
      h2
        | Tutorials
      p.desc
        | Get started on Nitrous with these tutorials

    section.tutorials.cards
      - @tutorials.each do |t|
        = render partial: 'layouts/tutorial_card', locals: { tutorial: t }

    .pagination.centered
      a.btn.bordered href="#"
        | More tutorials



    .title.centered
      h2
        | Blog posts
      p.desc
        | Anouncements, product news, and use-cases

    section.blog.cards

      - @blogs.each do |b|
        = render partial: 'layouts/blog_card', locals: { blog: b }

    .pagination.centered
      a.btn.bordered href="#"
        | More posts
