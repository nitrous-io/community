- @title = @content.title

- content_for :header_accessory do
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Doc', edit_doc_path(@content.id)
          - if @content.published?
            li
              = link_to 'Unpublish', unpublish_doc_path(@content.id), method: :doc
          - else
            li
              = link_to 'Publish', publish_doc_path(@content.id), method: :doc
          li.separator
          li
            = link_to 'Drafts', docs_drafts_path
      .divider
      
.main
  .container.with-sidebar
    article
      .title
        h2
          = @content.title
          
      .content
        = @content.content_html.html_safe

      .footer
        /- if @content.tags.present?
        / .tags
        /   - @content.tags.each do |tag|
        /     = link_to tag.name, docs_tagged_path(tag: tag.name)

        .heart
          = render partial: 'partials/heart', locals: { url: doc_likes_path(doc_id: @content.id), score: @content.score, is_upvoted: @is_upvoted }

        a.status-icon.share href="#share"
          span Share

        = render partial: 'partials/sharer', locals: { url: docs_slugged_url(slug: @content.slug)}

    = render partial: 'docs/sidebar', locals: { toc: @toc }

- content_for :body_script do
  = javascript_include_tag 'code-mirror'

