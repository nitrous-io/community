= render partial: 'partials/flash_message'

.post-index.row
  - @posts.each do |post|
      .col-sm-6.col-md-4
        h3
          = link_to post.title, posts_slugged_path(slug: post.slug)
        .author-signature
          = "By #{post.user.username}"
        p
          .time-signature
            = "Published #{time_ago_in_words(post.created_at)} ago"
            .tags
              - if post.tags.present?
                - post.tags.each do |tag|
                  = link_to tag.name, posts_tagged_path(tag: tag.name)
        = link_to 'Edit', edit_post_path(post.id), role: 'button', class: 'btn btn-default'
        a.btn.btn-danger href="#" role="button"  Delete