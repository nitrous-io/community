- content_for :header_accessory
  = render partial: 'partials/post_publish_menu', locals: { item: @content }

.main
  .container
    / = render partial: 'partials/flash_message'

    = render partial: 'partials/form', locals: { _item: @content, _url: posts_path, _method: :post, _form_id: 'new_post' }

= content_for :body_script do
  = javascript_include_tag 'code-mirror'
  javascript:
    Community.EditPage.init();
