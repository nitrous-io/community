.form-wrapper
  .row
    = f.text_field :title, class: 'form-control', tabindex: 1, placeholder: "Title"

  .row.tabs
    a data-toggle='tab' href='#content' aria-controls='content' role='tab'
      | Content
    a data-toggle='tab' href='#preview' aria-controls='preview' role='tab'
      | Preview

  .row
    = f.text_area :content_markdown, class: 'markdown-text-js form-control', rows: 15, tabindex: 2, 'data-attachment-allowed' => true

  .row
    = f.text_field :tag_list, class: 'form-control', placeholder: 'Tags (eg. ruby, rails)', tabindex: 3, value: f.object.tag_list.join(', ')

  .row
    = f.text_field :cover_image_url, class: 'form-control', placeholder: 'Cover image', tabindex: 4

  .row
    = f.submit 'Save as Draft', class: 'btn btn-primary'