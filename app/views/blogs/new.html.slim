.main
  .container

    / .errors
    /   = @blog.errors.full_messages.first if @blog.errors.any?

    .form-wrapper
      = form_for @blog, url: blogs_path do |f|
        .row
          = f.label :title

        .row
          = f.text_field :title

        .row
          = f.label :content

        .row
          = f.text_area :content_markdown, class: "markdown-text-js"

        .row
          = f.label :tag_list

        .row
          = f.text_field :tag_list, placeholder: "eg. ruby, rails"

        .row
          = f.submit "Publish blog post"
