.main
  .container
    .form-wrapper
      - if @content.length > 0
        = form_tag(doc_categories_path, method: :put, id: 'doc_category_list', data: { 'no-confirm-close' => true }) do
          - @content.each do |category|
            .row.table
              span.handle
                i.fa.fa-reorder
              input type='hidden' class="position" name="doc_categories[#{category.id.to_s}][position]" value=(category.position) required=true
              input type='text' name="doc_categories[#{category.id.to_s}][name]" value=(category.name) required=true

              = link_to '&#xf00d;'.html_safe, doc_category_path(category), method: :delete, class: 'btn transp', data: { confirm: 'Are you sure?', 'no-confirm-close' => true }

          .row
            = submit_tag 'Save changes', data: { disable_with: 'Saving...' }, class: 'btn blue'

      = form_for(@new_category, method: :post, data: { 'no-confirm-close' => true }) do |f|
        .row.table
          = f.text_field :position, type: 'hidden', required: true, class: 'position'
          = f.text_field :name, placeholder: 'Category Name', required: true
          = f.submit value: '&#xf067;'.html_safe, class: 'btn blue'

= content_for :body_script do
  javascript:
    Community.DocCategoriesPage.init();
