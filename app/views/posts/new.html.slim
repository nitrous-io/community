.post-new
  = render partial: 'partials/flash_message'
  .row
    .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
      h1.title New Post

  = form_for @post, url: posts_path do |f|
    .row
      .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
        .form-group
          = f.label :title
          = f.text_field :title, class: 'form-control', tabindex: 1

        ul.nav.nav-pills data-preview-tab='true'
          li.active role='presentation'
            a data-toggle='tab' href='#content' aria-controls='content' role='tab'
              | Content
          li role='presentation'
            a.preview-btn-js data-toggle='tab' href='#preview' aria-controls='preview' role='tab'
              | Preview

        .form-group
          .tab-content
            #content.tab-pane.active role='tabpanel'
              = f.text_area :content_markdown, class: 'markdown-text-js form-control', rows: 15, tabindex: 2, 'data-attachment-allowed' => true
              p.help-block
                | Upload your post in markdown format. Fenced code blocks are supported.
                br
                | To upload an image, drag and drop it into the textarea.
            #preview.tab-pane role='tabpanel'
              .preview-content.preview-content-js

        .form-group
          = f.label :tag_list
          = f.text_field :tag_list, class: 'form-control', placeholder: 'eg. ruby, rails', tabindex: 2

    .row
      .col-xs-4.col-md-4.col-lg-4.col-md-offset-5.col-lg-offset-5
        .card-submit-btn
          = f.submit 'Upload new blog post', class: 'btn btn-default btn-primary'