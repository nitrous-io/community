.main
  .container
    
    .tabs
      ul
        li
          a.active href="#all" All
        li
          a href="#tutorials" Tutorials
        li
          a href="#posts" Blog Posts


    section#tutorials.tutorials.cards.tab
      - @tutorials.each do |t|
        = render partial: 'partials/tutorial_card', locals: { tutorial: t }

    section#posts.blog.cards.tab
      - @posts.each do |p|
        = render partial: 'partials/post_card', locals: { post: p }