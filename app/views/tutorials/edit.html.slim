.tutorial-new
  = render partial: 'partials/flash_message'
  .row
    .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
      h1.title Edit Tutorial

  = form_for @tutorial, url: tutorial_path(@tutorial.id), method: :put do |f|
    = render partial: 'partials/form', locals: { f: f }

    .row
      .col-xs-4.col-md-4.col-lg-4.col-md-offset-5.col-lg-offset-5
        .card-submit-btn
          = f.submit 'Edit tutorial', class: 'btn btn-primary'