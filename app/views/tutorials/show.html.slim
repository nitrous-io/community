.tutorial-show
  h1.title
    = @tutorial.title
  .content
    = @tutorial.content_html.html_safe
  .author-signature
    = @tutorial.user.username
  .tags
    - if @tutorial.tags.present?
      - @tutorial.tags.each do |tag|
        = link_to tag.name, tutorials_tagged_path(tag: tag.name)
  br

  h2.comment-title Comments

  = form_for @comment, url: tutorial_comments_path(@tutorial.id) do |f|
    .row
      = f.label :comment
    .row.content
      = f.text_area :content

    .row
      = f.submit 'Tutorial comment'

  .comment-list
    - @comments.each do |comment|
      .row
        .content
          = comment.content
        .author-signature
          | By
          = comment.user.username
          .time-signature
            | Commented
            = time_ago_in_words(comment.created_at)
            | ago
  br
  .vote
    = button_to "hearts", tutorial_likes_path(@tutorial.id), method: :post

  = @tutorial.score