header
  .container
    h1.logo
      a href=(root_path)
        span
          em Nitrous
          '
          small Community

    nav
      ul
        li class=(controller.controller_name == 'tutorials' ? 'active' : nil)
          = link_to "Tutorials", tutorials_path
        li class=(controller.controller_name == 'posts' ? 'active' : nil)
          = link_to "Blog", posts_path

    .actions
      .desktop
        - if current_user.nil?
          = link_to "Log In / Sign Up", login_path, class: (controller.controller_name == 'sessions' ? 'active' : nil)

        - else
          - if @edit_mode
            - if controller.controller_name == 'posts'
              = render partial: 'partials/post_publish_menu', locals: { item: @post }
            - elsif controller.controller_name == 'tutorials'
              = render partial: 'partials/tutorial_publish_menu', locals: { item: @tutorial }

          .dropdown
            .dropdown-toggle
              span.gravatar
                img src="http://www.gravatar.com/avatar/00000000000000000000000000000000?d=retro&amp;f=y"
              span.username
                = current_user.username
              i.fa.fa-caret-down

              ul.dropdown-menu role="menu"
                - if current_user.admin?
                  li
                    = link_to "New Tutorial", new_tutorial_path
                  li
                    = link_to "New Blog Post", new_post_path
                  li
                    = link_to 'Drafts', drafts_path
                  li.separator
                li
                  = link_to "Log Out", sessions_path, :method => :delete

      .menu-btn.mobile
        a.trigger href="#"


#mobile-menu
  ul.nav
    li
      = link_to "Tutorials", tutorials_path
    li
      = link_to "Blog", posts_path
    li
      a href="/" Search

    - if current_user.nil?
      li.separator
      li
        = link_to "Log In", login_path
      li
        a href="https://pro.nitrous.io/app/#/signup" Sign Up
    - else
      li.separator
      li
        = link_to "Log Out", sessions_path, :method => :delete

    li.separator
    li
      a href="https://twitter.com/nitrous.io" target="_blank" Follow @NitrousIO
    li
      p &copy; 2012-2015 Nitrous, Inc.
