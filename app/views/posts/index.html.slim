.main
  .container
    / = render partial: 'partials/flash_message'

    .title.centered
      h2
        | Blog Posts
      p.desc
        | Anouncements, product news, and use-cases

    section.blog.cards
      - @posts.each do |post|
        = render partial: 'partials/post_card', locals: { post: post, url_prefix: '/posts'}
