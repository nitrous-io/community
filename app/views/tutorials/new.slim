- content_for :header_accessory
  = render partial: 'partials/tutorial_publish_menu', locals: { item: @tutorial }

.main
  .container
    / = render partial: 'partials/flash_message'

    = render partial: 'partials/form', locals: { _item: @tutorial, _url: tutorials_path, _method: :post, _form_id: 'new_tutorial' }

= content_for :body_script do
  = javascript_include_tag 'code-mirror'
  javascript:
    Community.EditPage.init();
