.main
  .container

    / - flash.each do |name, message|
    /   = message

    article
      .title
        h2
          = @tutorial.title

      .meta
        .author
          span
            = @tutorial.author.capitalize
        span &bull;
        .timestamp
          span
            | 2 days ago


      .content
        = @tutorial.content_html.html_safe


      .footer
        .gravatar
          img src="http://www.gravatar.com/avatar/00000000000000000000000000000000?d=retro&amp;f=y"

        .author
          span
            = @tutorial.author

        .status
          a.hearts href="#"
            span
              = @tutorial.score
          a.comments href="#"
            span 6

          a.share href="#"
            span Share

      / .tags
      /   - if @tutorial.tags.present?
      /     - @tutorial.tags.each do |tag|
      /       = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}


.main.darker
  .container

    article
      .title
        h2
          | Comments

      .form-wrapper
        = form_for @comment, url: comments_path(tutorial_id: @tutorial.id, slug: @tutorial.slug) do |f|
          = f.text_area :content

          .row
            = f.submit "Post comment"

      .comment-list
        - @comments.each do |comment|
          .comment
            .meta
              .author
                = comment.author.capitalize
              .timestamp
                = time_ago_in_words(comment.created_at)
                '  ago
            .content
              = comment.content
