= form_for _item, url: _url, method: _method, html: { id: _form_id } do |f|
  .form-wrapper
    .row
      = f.text_field :title, tabindex: 1, placeholder: "Title"

    .row
      = f.text_field :cover_image_url, placeholder: 'Cover image (URL)', tabindex: 2
    
    .row
      = f.text_field :tag_list, 'data-role' => 'tagsinput', tabindex: 3, value: f.object.tag_list.join(', ')

    .tab-wrapper
      .row.tabs
        ul
          li
            a.toggle href='#content'
              | Content
          li
            a.toggle href='#preview' data-preview-tab="true"
              | Preview

      .tab-content
        #content.row
          = f.text_area :content_markdown, class: 'markdown-text-js', rows: 15, tabindex: 2, 'data-attachment-allowed' => true
        #preview.row
          .preview-content-js

- if _item.persisted?
  = form_tag publish_post_path(_item.id), method: :put do
    = datetime_field :post, :published_at, placeholder: '2014-05-20T00:00:00.000+0000'
    = submit_tag 'Publish', role: 'button', class: 'btn btn-info'