.comment
  a.anchor id="comment-#{comment.id}"
  .meta
    .gravatar
      img src=(comment.user.gravatar(76))
    .author
      span.username
        = comment.user.username.capitalize
    .timestamp
      a href='#comment-#{comment.id}'
        span
          = time_ago_in_words(comment.created_at)
          '  ago
  .content
    = comment.content
