.blog-new
  .errors
    = @post.errors.full_messages.first if @post.errors.any?

  .row
    .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
      h1.title New Post
      .desc 
        | Upload your post in markdown format. Fenced code blocks are supported.
        br
        | To upload an image, drag and drop it into the textarea.

  = form_for @post, url: posts_path do |f|
    .row
      .col-xs-12.col-md-8.col-lg-8.col-md-offset-2.col-lg-offset-2
        .card-entry
          .row
            = f.label :title
          .row
            = f.select :type, options_for_select([%w(Blog blog), %w(Tutorial tutorial)], @post.type || 'blog')
          .row
            = f.text_field :title
          .row
            = f.label :content
          .row.content
            = f.text_area :content_markdown, class: 'markdown-text-js', 'data-attachment-allowed' => true

          .row
            = f.label :tag_list
          .row
            = f.text_field :tag_list, placeholder: 'eg. ruby, rails'

    .row
      .col-xs-4.col-md-4.col-lg-4.col-md-offset-5.col-lg-offset-5
        .card-submit-btn
          = f.submit 'Upload new blog post'

  .row.preview-btn-js
    | Click to preview markdown post

  .row
    .preview-content-js
