.post-new
  = render partial: 'partials/flash_message'
  .row
    .col-md-2.col-md-offset-2
      h1.title Edit Post
    .col-md-offset-5.col-md-2
      = link_to 'Delete', post_path(@post.id),
                role: 'button', class: 'btn btn-danger',
                'data-confirm' => 'Are you sure?', 'data-method' => :delete
      - if @post.published?
        = link_to 'Unpublish', unpublish_post_path(@post.id),
                role: 'button', class: 'btn btn-info', 'data-method' => :put
      - else
        = link_to 'Publish', publish_post_path(@post.id),
                  role: 'button', class: 'btn btn-info', 'data-method' => :put

  = form_for @post, url: post_path(@post.id), method: :put do |f|
    = render partial: 'partials/form', locals: { f: f }

    .row
      .col-xs-4.col-md-4.col-lg-4.col-md-offset-5.col-lg-offset-5
        .card-submit-btn
          = f.submit 'Edit blog post', class: 'btn btn-primary'
