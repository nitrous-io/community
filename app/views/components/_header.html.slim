.header
  span.logo 
    = link_to "NITROUS Community", root_path
  
  .section-links 
    li
      = link_to 'Tutorials', posts_path(type: :tutorial)
    li
      = link_to 'Posts', posts_path(type: :post)

  - if current_user.nil?
    ul.unauthed.pull-right
      li.login.btn.btn-default.navbar-btn
        = link_to "Log In", login_path

  - else
    ul.authed.pull-right
      li.dropdown.pull-right
        button#dropdownMenu1.btn.btn-default.dropdown-toggle aria-expanded="true" data-toggle="dropdown" type="button" 
          span.username
            = current_user.username
          span.caret
        ul.dropdown-menu aria-labelledby="dropdownMenu1" role="menu" 
          li role="presentation" 
            = link_to "logout", sessions_path, :method => :delete

      - if current_user.admin
        li.new-tutorial.btn.btn-default.navbar-btn
          = link_to "New Post", new_post_path(type: :post)
        li.new-tutorial.btn.btn-default.navbar-btn
          = link_to "New Tutorial", new_post_path(type: :tutorial)

