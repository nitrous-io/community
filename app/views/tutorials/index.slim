- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :tutorial }

.main.title-hero.stacks
  .container
    .title
      h2 Tutorials
    p.desc
      | Guides and best practices

.hero-bar
  .container
    ul
      li.tutorials-deploy
        a href="/tutorials/tagged/deploy" Deploy
      li.tutorials-rails
        a href="/tutorials/tagged/rails" Rails
      li.tutorials-meteor
        a href="/tutorials/tagged/meteor" Meteor
      li.tutorials-docker
        a href="/tutorials/tagged/docker" Docker
      li.tutorials-parse
        a href="/tutorials/tagged/parse" Parse
      li.contribute
        a.btn.bordered href="#" Write a Tutorial

.main
  .container
    #tutorials
      = render partial: 'tutorials/list', locals: { tutorials: @content }
