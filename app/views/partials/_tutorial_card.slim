- link = tutorial.published? ? tutorials_slugged_path(slug: tutorial.slug) : edit_tutorial_path(id: tutorial.id)

- tag_classes = tutorial.tags.map { |t| "tag-#{t}" }.join " "
- tag_classes << ' will-be-published' if tutorial.will_be_published?

.tutorial.card class=tag_classes
  .content
    .visual class=("overlay-#{rand(1..5)}")
      a href=(link)
        span.icon-overlay

    h3.card-title
      = link_to tutorial.title, link

    .status
      a.hearts href=(link)
        span
          = tutorial.score
      a.comments href=(link)
        span
          = tutorial.comments.count
          / FIXME: need to be cached by counter_cache or something

    .card-footer
      .author
        .gravatar
          img src=(tutorial.user.gravatar(56))
        = tutorial.user.username
      - if tutorial.tags.present?
        .tags
          - tutorial.tags.take(2).each do |tag|
            = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}
            
          - if tutorial.tags.size > 2
            a.tag.ellipsis href=link
              i.fa.fa-ellipsis-h
