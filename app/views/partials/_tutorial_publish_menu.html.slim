.dropdown
  .dropdown-toggle
    span Publish
    i.fa.fa-caret-down
    ul.dropdown-menu role="menu"
      - if item.new_record?
        li
          = link_to 'Save as Draft', '#', data: { 'form-id' => '#tutorial-form' }
      - else
        - if item.published?
          li
            = link_to 'Save as Draft', unpublish_tutorial_path(item.id), method: :put
          li.separator
          li
            a href="#" Share Link
        - else
          li
            = link_to 'Publish', publish_tutorial_path(item.id), method: :put
          li.separator
          li
            = link_to 'Delete', tutorial_path(item.id), method: :delete
.divider