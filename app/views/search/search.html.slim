.main
  .container
    .centered
      = form_tag search_path, method: :get, id: 'search_form' do
        = text_field_tag 'q', params[:q].try(:strip), placeholder: 'Search'

    .tabs
      ul
        li
          = link_to 'All', '#all'
        li
          = link_to 'Tutorial', '#tutorials'
        li
          = link_to 'Blog Posts', '#posts'

    #all
      = render partial: 'tutorials/list', locals: { tutorials: @tutorials, next_page_path: '#' }
      = render partial: 'posts/list', locals: { posts: @posts, next_page_path: '#' }

    #tutorials

    #posts


= content_for :body_after do
  javascript:
    new Community.Search($('#search_form'), $('.tabs li a'));