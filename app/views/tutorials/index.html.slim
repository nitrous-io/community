.main
  .container
    / = render partial: 'partials/flash_message'

    .title.centered
      h2
        | Tutorials
      p.desc
        | Get started on Nitrous with these tutorials

    section.tutorials.cards
      - @tutorials.each do |tutorial|
        = render partial: 'partials/tutorial_card', locals: { tutorial: tutorial, url_prefix: '/tutorials'}
