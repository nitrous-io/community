doctype html
html lang="en" class=(full_controller_action_name)
  head
    meta charset="utf-8"
    meta http-equiv="X-UA-Compatible" content="IE=edge"
    meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    meta name="apple-mobile-web-app-title" content="Community"
    meta property="og:site_name" content="Nitrous Community"

    title
      = @title.blank? ? "Nitrous Community" : "#{@title} · Nitrous Community"

    = favicon_link_tag
    = favicon_link_tag 'favicon-96x96.png', sizes: '96x96'
    = favicon_link_tag 'favicon-32x32.png', sizes: '32x32'
    = favicon_link_tag 'apple-icon.png', rel: 'apple-touch-icon'

    = yield :head_before
    = stylesheet_link_tag 'application', media: 'all'
    = yield :head_stylesheet
    = csrf_meta_tags
    = yield :head_after

  body
    = yield :body_before
    = render partial: 'partials/flash_message'
    = render 'layouts/header'
    = yield
    = render 'layouts/footer'
    = javascript_include_tag 'application'
    = yield :body_script
    = yield :body_after
