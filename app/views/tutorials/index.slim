- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :tutorial }

.main.title-hero.stacks
  .container
    .title
      h2 Tutorials
    p.desc
      | Guides and best practices

.hero-bar
  .container
    ul
      li.tutorials-deploy
        a href="/tutorials/tagged/deploy" Deploy
      li.tutorials-rails
        a href="/tutorials/tagged/rails" Rails
      li.tutorials-nodejs
        a href="/tutorials/tagged/nodejs" Node.js
      li.tutorials-meteor
        a href="/tutorials/tagged/meteor" Meteor
      li.tutorials-docker
        a href="/tutorials/tagged/docker" Docker
      li.tutorials-go
        a href="/tutorials/tagged/go" Go
      li.tutorials-parse
        a href="/tutorials/tagged/parse" Parse
      li.tutorials-jekyll
        a href="/tutorials/tagged/jekyll" Jekyll
      li.contribute
        = link_to 'Write a Tutorial', new_tutorial_path, class: 'btn bordered'

.main
  .container
    #tutorials
      = render partial: 'tutorials/list', locals: { tutorials: @content }
