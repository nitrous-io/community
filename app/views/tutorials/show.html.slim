.tutorial-show
  h1.title
    = @tutorial.title
  .content
    = @tutorial.content_html.html_safe
  .author-signature
    = @tutorial.author
  .tags
    - if @tutorial.tags.present?
      - @tutorial.tags.each do |tag|
        = link_to tag.name, tutorials_tagged_path(tag: tag.name)
  br

  h2.comment-title Comments

  = form_for @comment, url: comments_path(tutorial_id: @tutorial.id, slug: @tutorial.slug) do |f|
    .row 
      = f.label :comment
    .row.content
      = f.text_area :content

    .row
      = f.submit "Post comment"

  .comment-list
    - @comments.each do |comment|
      .row
        .content
          = comment.content
        .author-signature
          | By 
          = comment.author
          .time-signature
            | Published 
            = time_ago_in_words(comment.created_at)
            |  ago
    br
