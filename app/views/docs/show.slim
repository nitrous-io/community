- content_for :head_meta do
  meta name="twitter:card" content="summary"
  meta name="twitter:url" content=posts_slugged_url(slug: @content.slug)
  meta name="twitter:title" content=@content.title
  meta name="twitter:description" content=@content.content_text.truncate(100).html_safe
  meta name="twitter:image" content=image_url("apple-icon.png")
  meta name="twitter:site" content="@nitrous"
  meta name="twitter:creator" content="@nitrous"

- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :doc }

- @title = @content.title

- content_for :header_accessory do
  - if current_user.try(:can_edit?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        .dropdown-menu
          ul role="menu"
            li
              = link_to 'Edit Doc', edit_doc_path(@content.id)
            - if @content.published?
              li
                = link_to 'Unpublish', unpublish_doc_path(@content.id), method: :doc
            - else
              li
                = link_to 'Publish', publish_doc_path(@content.id), method: :doc
            li.separator
            li
              = link_to 'Drafts', docs_drafts_path
      .divider

.main
  .container.with-sidebar
    article
      .title
        h2
          = @content.title

      .content
        = @content.content_html.html_safe

      .footer
        = render partial: 'partials/heart', locals: { score: @content.score, is_upvoted: @is_upvoted, like_path: like_doc_path(@content.id), unlike_path: unlike_doc_path(@content.id) }

        a.status-icon.share href="#share"
          span Share

        = render partial: 'partials/sharer', locals: { url: docs_slugged_url(slug: @content.slug)}

    = render partial: 'docs/sidebar', locals: { toc: @toc, active_doc: @content }

- if current_user.nil?
  = render 'partials/cta'

- content_for :body_script do
  = javascript_include_tag 'code-mirror'
  javascript:
    Community.ShowPage.init();
