- flash.each do |name, message|
  div class="login #{name}"
    = message.humanize

.login-card
  .card-header
    h2 Login

  = form_for :user, url: login_path do |f|
    .card-entry
      label Username or Email
      = f.text_field :username_or_email

      label Password
      = f.password_field :password

    .card-login-btn
      = f.submit "LOG IN"
