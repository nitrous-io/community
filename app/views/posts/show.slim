- @title = @post.title
- content_for :header_accessory
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Blog Post', edit_post_path(@post.id)
          - if @post.published?
            li
              = link_to 'Unpublish', unpublish_post_path(@post.id), data: { method: :put }
          - else
            li
              = link_to 'Publish', publish_post_path(@post.id), method: :put
      .divider

- title_style = @post.cover_image_url.present? ? "background: url('#{@post.cover_image_url}') center center fixed;" : ''
.main.title-hero style="#{title_style}"
  .container
    .title
      h2
        = @post.title
    .meta
      span.time
        = l @post.created_at, format: :simple
      span.bull-separator
        | &bull;
      a.comment href="#comments"
        = pluralize(@comments.count, 'Comment')

.main
  .container
    article
      .content
        = @post.content_html.html_safe

      .footer
        /- if @post.tags.present?
        / .tags
        /   - @post.tags.each do |tag|
        /     = link_to tag.name, posts_tagged_path(tag: tag.name)

        .heart
          = render partial: 'partials/heart', locals: { url: post_likes_path(post_id: @post.id), score: @post.score, is_upvoted: @is_upvoted }

        a.status-icon.comment href="#the-comments"
          span
            = pluralize(@post.comments.count, 'Comment')

        a.status-icon.share href="#share"
          span Share

        = render partial: 'partials/sharer', locals: { url: posts_slugged_url(slug: @post.slug)}

.main.darker
  .container

    article#comments
      .title
        h2
          | Comments

      .form-wrapper
        = form_for @comment, url: post_comments_path(@post.id) do |f|
          = f.text_area :content, placeholder: "Write a comment..."

          .row
            = f.submit "Post comment"

      #the-comments.comment-list
        - @comments.each do |comment|
          = render partial: 'partials/comment', locals: { comment: comment }

= content_for :body_script do
  = javascript_include_tag 'code-mirror'
