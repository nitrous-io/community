h1 New Tutorial 

= @tutorial.errors.full_messages.first if @tutorial.errors.any?

= form_for @tutorial, url: tutorials_path, html: {class: "form"} do |f|
  = f.label :title
  = f.text_field :title

  = f.label :content
  = f.text_area :content_markdown

  = f.label :tag_list
  = f.text_field :tag_list

  = f.submit "Submit new tutorial"
