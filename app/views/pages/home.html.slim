.home-tutorial-index
  .row
    h1.section-title Tutorials
    .section-desc Get started on Nitrous with these tutorials
  .row
    - @tutorials.each do |tutorial|
      .col-xs-6.col-md-4.col-lg-4
        .tutorial-card
          h1.title
            = link_to tutorial.title, tutorial_path(slug: tutorial.slug)
          .author-signature
            | By 
            = tutorial.author
            .time-signature
              | Published 
              = time_ago_in_words(tutorial.created_at)
              |  ago
          - if tutorial.tags.present?
            - tutorial.tags.each do |tag|
              span.tags
                = link_to tag.name, tutorials_tagged_path(tag: tag.name)
          br
