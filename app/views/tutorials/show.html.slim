- @title = @tutorial.title
- content_for :header_accessory
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Tutorial', edit_tutorial_path(@tutorial.id)
          - if @tutorial.published?
            li
              = link_to 'Unpublish', unpublish_tutorial_path(@tutorial.id), data: { method: :put }
          - else
            li
              = link_to 'Publish', publish_tutorial_path(@tutorial.id), method: :put
      .divider

.main
  .container
    article
      .title
        h2
          = @tutorial.title

      .meta
        .timestamp
          span
            = l @tutorial.created_at, format: :simple
        .tags
          - if @tutorial.tags.present?
            - @tutorial.tags.each do |tag|
              = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

      .content
        = @tutorial.content_html.html_safe

      .footer
        / .tags
        /   - if @tutorial.tags.present?
        /     - @tutorial.tags.each do |tag|
        /       = link_to tag.name, tutorials_tagged_path(tag: tag.name), { :class => "tag"}

        .heart
          = render partial: 'partials/heart', locals: { url: tutorial_likes_path(tutorial_id: @tutorial.id), score: @tutorial.score, is_upvoted: @is_upvoted }

        a.status-icon.comment href="#comments"
          span
            = @tutorial.comments.count
            |  Comments

        a.status-icon.share href="#share"
          span Share

        = render partial: 'partials/sharer', locals: { url: tutorials_slugged_url(slug: @tutorial.slug)}



.main.darker
  .container
    article#comments
      .title
        h2
          | Comments

      .form-wrapper
        = render partial: 'partials/comments_with_form', locals: { comment: @comment, comments: @comments, create_comment_path: tutorial_comments_path(@tutorial.id) }

= content_for :body_script do
  = javascript_include_tag 'code-mirror'
