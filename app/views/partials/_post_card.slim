- link = post.published? ? posts_slugged_path(slug: post.slug) : edit_post_path(id: post.id)

- if defined?(focus) && focus
  .main.post-hero style="background: url('#{post.cover_image_url}') center center fixed;"
    a href=(link) class="cover"
    .container
      span.small
        | Latest article

      h3.card-title
        = link_to post.title, link

      a.btn.bordered href=(link)
        | Read Now


- else
  - classes = %w(blog card)
  - classes << 'will-be-published' if post.will_be_published?

  div class=(classes.join(' '))
    .content
      .visual
        a href=(link) style="background-image: url('#{post.cover_image_url}');"

      h3.card-title
        = link_to post.title, link

      - unless post.content_text.nil?
        p
          = post.content_text.truncate(100)
