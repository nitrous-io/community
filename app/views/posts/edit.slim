- content_for :header_accessory do
  = render partial: 'partials/post_publish_menu', locals: { item: @content }

.main
  .container
    = render partial: 'partials/form', locals: { _item: @content, _url: post_path(@content.id), _method: :put, _form_id: 'edit_post', _post_cover_image: true }

- content_for :body_script do
  = javascript_include_tag 'code-mirror'
  javascript:
    Community.EditPage.init();
