h1.logo
  a href=(root_path)
    span
      em Nitrous
      '
      small Community
nav
  ul
    li class=(current_page?(controller: 'tutorials') ? 'active' : nil)
      = link_to "Tutorials", tutorials_path
    li class=(current_page?(controller: 'blogs') ? 'active' : nil)
      = link_to "Blog", blogs_path

.actions
  - if @current_user.nil?
    = link_to "Log In", login_path

  - else
    ul.authed
      li.dropdown
        a.btn.dropdown-toggle aria-expanded="true" data-toggle="dropdown" type="button"
          span.username
            = @current_user
          i.fa.fa-caret

        ul.dropdown-menu role="menu"
          li
            = link_to "logout", logout_path, :method => :delete

      - if @admin
        li.new-tutorial.btn
          = link_to "New Tutorial", new_tutorial_path

#menu
  a.trigger href="#"


#mobile-menu
  ul.nav
    li
      = link_to "Tutorials", tutorials_path
    li
      = link_to "Blog", blogs_path
    li
      a href="/" Search
    li.separator
    - if @current_user.nil?
      li
        = link_to "Log In", login_path
      li
        a href="/" Sign up
    li.separator
    li
      a href="https://twitter.com/nitrous.io" target="_blank" Follow @NitrousIO
    li
      p &copy; 2012-2015 Nitrous, Inc.
