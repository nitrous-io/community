- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :tutorial }

.main
  .container
    .title.centered
      h2
        a href=tutorials_path
          | Tutorials
      p.desc
        | Guides and best practices

    section.tutorials.cards
      - @tutorials.each do |t|
        = render partial: 'partials/tutorial_card', locals: { tutorial: t }

    section.centered
      a.btn.bordered href=tutorials_path
        | More tutorials


    .title.centered
      h2
        a href=posts_path
          | Latest Updates
      p.desc
        | Anouncements, product news, use-cases, and more

    section.blog.cards
      - @posts.each do |p|
        = render partial: 'partials/post_card', locals: { post: p }

    section.centered
      a.btn.bordered href=posts_path
        | More posts


    .title.centered
      h2
        a href="/docs"
          | Docs
      p.desc
        | Documentation &amp; help for everything Nitrous

    = render partial: 'docs/toc', locals: { toc: @docs_toc, num_docs: 3, num_categories: 9 }
