- @title = @post.title
- content_for :header_accessory
  - if current_user.try(:admin?)
    .dropdown
      .dropdown-toggle
        span Edit
        i.fa.fa-caret-down
        ul.dropdown-menu role="menu"
          li
            = link_to 'Edit Blog Post', edit_post_path(@post.id)
          - if @post.published?
            li
              = link_to 'Unpublish', unpublish_post_path(@post.id), data: { method: :put }
          - else
            li
              = link_to 'Publish', publish_post_path(@post.id), method: :put
            
      .divider

.main.title-hero
  .container
    .title
      h2
        = @post.title
    .meta
      span.time
        = l @post.created_at, format: :simple
      span.bull-separator
        | &bull;
      a.comment href="#comments"
        = @comments.count
        |  Comments

.main
  .container
  
    article
      .content
        = @post.content_html.html_safe

      .footer
        .heart
          = button_to "Heart", post_likes_path(post_id: @post.id), method: :post, class: "status-icon heart"
        /- if @post.tags.present?
        / .tags
        /   - @post.tags.each do |tag|
        /     = link_to tag.name, posts_tagged_path(tag: tag.name)

        .status
          a.status-icon.comment href="#comments"
            span Comment

          a.status-icon.share href="#share"
            span Share

          = render partial: 'partials/sharer'


.main.darker
  .container

    article#comments
      .title
        h2
          | Comments

      .form-wrapper
        = form_for @comment, url: post_comments_path(@post.id) do |f|
          = f.text_area :content, placeholder: "Write a comment..."

          .row
            = f.submit "Post comment"

      .comment-list
        - @comments.each do |comment|
          = render partial: 'partials/comment', locals: { comment: comment }

= content_for :body_script do
  = javascript_include_tag 'code-mirror'