- content_for :search_field do
  = render partial: 'partials/search', locals: { kind: :post }

- if @cover_content.present?
  = render partial: 'partials/post_card', locals: { post: @cover_content, url_prefix: '/posts', focus: true}

.main
  .container
    #posts
      = render partial: 'posts/list', locals: { posts: @content }
