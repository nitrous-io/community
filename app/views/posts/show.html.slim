.post-show
  h1.title
    = @post.title
  .content
    = @post.content_html.html_safe
  .author-signature
    = @post.user.username
  .tags
    - if @post.tags.present?
      - @post.tags.each do |tag|
        = link_to tag.name, posts_tagged_path(type: @post.type, tag: tag.name)
  br

  h2.comment-title Comments

  = form_for @comment, url: comments_path(post_id: @post.id, slug: @post.slug) do |f|
    .row
      = f.label :comment
    .row.content
      = f.text_area :content

    .row
      = f.submit "Post comment"

  .comment-list
    - @comments.each do |comment|
      .row
        .content
          = comment.content
        .author-signature
          | By
          = comment.author
          .time-signature
            | Commented
            = time_ago_in_words(comment.created_at)
            | ago
  br
  .vote
    = button_to "hearts", post_likes_path(post_id: @post.id, slug: @post.slug), method: :post

  = @post.score