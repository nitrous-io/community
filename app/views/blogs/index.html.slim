.main
  .container

    .title.centered
      h2
        | Blog posts
      p.desc
        | Anouncements, product news, and use-cases


    / - flash.each do |name, message|
    /   div class="new-blog-post #{name}"
    /     = message.humanize


    section.tutorials.cards
      - @blogs.each do |blog|
        = render partial: 'layouts/blog_card', locals: { blog: blog }
