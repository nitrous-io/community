.main
  .container

    .title.centered
      h2
        | Tutorials
      p.desc
        | Get started on Nitrous with these tutorials

    section.tutorials.cards
      - @tutorials.each do |t|
        = render partial: 'partials/tutorial_card', locals: { tutorial: t }
    
    section.centered
      a.btn.bordered href="/tutorials"
        | More tutorials

    .title.centered
      h2
        | Latest Updates
      p.desc
        | Anouncements, product news, and use-cases

    section.blog.cards
      - @posts.each do |p|
        = render partial: 'partials/post_card', locals: { post: p }
    
    section.centered
      a.btn.bordered href="/posts"
        | More posts